# Secrets: never commit. Copy .env.example to .env and fill in your keys.
.env
.env.*
!.env.example

# Working notes (project instructions, roadmap, ADRs, design docs) stay on this machine.
# README.md is the only Markdown file that is published.
*.md
!README.md

# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/

# Local SQLite databases (scan history and cache), created on first start
*.db
*.db-shm
*.db-wal

# Node / Vite
node_modules/
dist/
*.tsbuildinfo
*.log

# Editors, tools and OS
.idea/
.vscode/
.claude/
Thumbs.db
.DS_Store
