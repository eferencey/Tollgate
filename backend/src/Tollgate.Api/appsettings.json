{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Providers": {
    "Resilience": {
      "AttemptTimeout": { "Timeout": "00:00:10" },
      "TotalRequestTimeout": { "Timeout": "00:00:25" },
      "Retry": { "MaxRetryAttempts": 2 }
    },
    "VirusTotal": {
      "BaseAddress": "https://www.virustotal.com/api/v3/",
      "AnalysisPollAttempts": 1,
      "AnalysisPollDelay": "00:00:05"
    },
    "SafeBrowsing": {
      "BaseAddress": "https://safebrowsing.googleapis.com/v4/"
    },
    "UrlHaus": {
      "BaseAddress": "https://urlhaus-api.abuse.ch/v1/"
    },
    "Rdap": {
      "BaseAddress": "https://rdap.org/"
    }
  },
  "Scan": {
    "CacheDuration": "01:00:00",
    "PollInterval": "00:00:20"
  },
  "Persistence": {
    "DataDirectory": "data"
  },
  "History": {
    "RetentionDays": 90,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "TopHostsCount": 10
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "Window": "00:01:00"
  },
  "VirusTotalQueue": {
    "MinSpacing": "00:00:15",
    "DailyLimit": 500,
    "MaxWait": "00:00:45"
  },
  "Scoring": {
    "VirusTotal": {
      "MaliciousPenaltyPerEngine": 12,
      "MaliciousMaxPenalty": 60,
      "SuspiciousPenaltyPerEngine": 5,
      "SuspiciousMaxPenalty": 20,
      "MaliciousCaps": [
        { "MinEngines": 2, "Cap": 45 },
        { "MinEngines": 5, "Cap": 15 }
      ]
    },
    "SafeBrowsing": {
      "ListedPenalty": 60,
      "ListedCap": 20
    },
    "UrlHaus": {
      "ActiveUrlPenalty": 80,
      "ActiveUrlCap": 5,
      "PastUrlPenalty": 40,
      "PastUrlCap": 35,
      "HostRecordBasePenalty": 8,
      "HostRecordPenaltyPerRecord": 2,
      "HostRecordMaxPenalty": 30
    },
    "DomainAge": {
      "VeryNewBelowDays": 30,
      "VeryNewPenalty": 15,
      "NewBelowDays": 180,
      "NewPenalty": 5
    },
    "LocalAnalysis": {
      "Lookalike": {
        "NonLatinAlphabetPenalty": 5,
        "MixedAlphabetPenalty": 40
      },
      "Typosquatting": {
        "ProtectedDomains": [
          "google.com", "youtube.com", "facebook.com", "instagram.com", "whatsapp.com", "twitter.com", "linkedin.com",
          "microsoft.com", "apple.com", "amazon.com", "netflix.com", "paypal.com", "ebay.com", "adobe.com", "dropbox.com",
          "github.com", "spotify.com", "binance.com", "coinbase.com",
          "trendyol.com", "hepsiburada.com", "sahibinden.com", "turkiye.gov.tr",
          "isbank.com.tr", "garantibbva.com.tr", "akbank.com", "ziraatbank.com.tr", "yapikredi.com.tr"
        ],
        "NearMatchMinLength": 5,
        "MaxEditDistance": 1,
        "SubstitutionPenalty": 45,
        "NearMatchPenalty": 30
      },
      "SuspiciousTld": {
        "Tlds": [ "zip", "mov", "top", "click", "country", "gq", "tk", "ml", "cf", "ga", "kim", "loan", "work", "men" ],
        "Penalty": 8
      },
      "IpHost": { "Penalty": 15 },
      "UserInfo": { "Penalty": 25 }
    },
    "VerdictThresholds": {
      "DangerousBelow": 50,
      "SuspiciousBelow": 80
    },
    "ConfidenceThresholds": {
      "HighMinSources": 4,
      "MediumMinSources": 2
    }
  }
}
