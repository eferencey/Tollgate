# Copy this file to .env and fill in your keys. .env is git-ignored.
# Leave a key empty to run that source in demo/mock mode.

# VirusTotal v3 (free key: 4 requests/min, 500/day)
VT_API_KEY=

# Google Safe Browsing v4 (non-commercial use only)
GSB_API_KEY=

# URLhaus Auth-Key (abuse.ch)
URLHAUS_AUTH_KEY=

# RDAP (rdap.org) needs no key.
